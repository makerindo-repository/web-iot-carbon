APP_NAME=AgriSense
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agrisense
DB_USERNAME=agrisense
DB_PASSWORD=change_this_db_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_USE_PATH_STYLE_ENDPOINT=false

# ═══════════════════════════════════════════
# CORS & Sanctum
# ═══════════════════════════════════════════
# Comma-separated frontend origins. Production WAJIB diisi.
# Empty value = tolak SEMUA cross-origin request (fail-secure).
# Contoh prod: https://agrisense.web.id,https://www.agrisense.web.id
# Contoh dev:  http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Sanctum SPA stateful domains (kosong = full bearer mode, tidak pakai cookie)
# Production: hanya isi jika frontend dan backend di SAME domain
SANCTUM_STATEFUL_DOMAINS=

# ═══════════════════════════════════════════
# API Keys (Wajib diisi untuk fitur terkait)
# ═══════════════════════════════════════════
# OpenWeather API — Digunakan untuk sinkronisasi data klimatologi BMKG
OPENWEATHER_API_KEY=

# Google Gemini AI — Primary AI provider
GEMINI_API_KEY=

# OpenRouter AI — First fallback provider (Qwen3 Coder 480B)
OPENROUTER_API_KEY=
CRON_SYNC_TOKEN=

# AI Model Bundle
AI_MODEL_BUNDLE_PATH=
PYTHON_EXECUTABLE=
AI_FORECAST_MODELS=svm,xgboost,lstm

# ═══════════════════════════════════════════
# MQTT Broker (HiveMQ) — listener: php artisan mqtt:listen
# ═══════════════════════════════════════════
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=agrisense/iot/readings
MQTT_TLS_VERIFY_PEER=false
MQTT_FORWARD_URL=http://127.0.0.1:8000/api/iot/agrisense/readings

VITE_APP_NAME="${APP_NAME}"
